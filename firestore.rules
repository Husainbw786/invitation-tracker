rules_version = '2';

// Paste these in: Firebase console -> Firestore Database -> Rules -> Publish.
//
// IMPORTANT, READ THIS:
// The app uses a simple hardcoded login (two emails checked in the browser),
// not Firebase Authentication. Firestore has no way to verify who is asking,
// so these rules must allow open access for the app to work at all.
//
// What that means in practice: anyone who knows the deployed URL, or the
// project id, can read, edit, or delete the guest list. The protection is
// simply that the URL is not published anywhere.
//
// Mitigations while staying on this setup:
//   - Use the Export CSV button now and then, so a wipe is recoverable.
//   - Do not post the URL publicly (no social media, no public repos/issues).
//
// To make this properly private later, switch the login to Firebase
// Authentication and replace the condition below with:
//     allow read, write: if request.auth != null;
// That is a small change in src/lib/auth.js plus adding the two users in the
// Firebase console.

service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{familyId} {
      allow read, write: if true;
    }
    // Nothing else in the database is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
