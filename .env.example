# Firebase config. Copy this file to `.env` and fill in the values from:
#   Firebase console -> Project settings (gear icon) -> General
#   -> Your apps -> Web app -> SDK setup and configuration -> Config
#
# With no `.env` file the app runs in LOCAL mode: families are saved only in
# this browser. Fill these in to switch on cloud sync across all devices.
#
# These values are NOT secrets. Firebase web config is meant to ship in the
# browser bundle; access is controlled by Firestore rules, not by hiding them.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
