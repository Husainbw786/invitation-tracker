# Optional. The app already has the Firebase web config built in
# (see src/lib/firebase.js), so it works with no configuration.
#
# Set these only if you move to a different Firebase project.
# Firebase web config is meant to be visible in the browser; the data is
# protected by Firebase Auth and the rules in firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
