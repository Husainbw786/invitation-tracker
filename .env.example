# Optional. The app already has the Supabase project URL and publishable key
# built in (see src/lib/supabase.js), so it works with no configuration.
#
# Set these only if you rotate the key or move to a different Supabase project.
# Supabase publishable keys are meant to be visible in the browser; the
# database is protected by Row Level Security policies, not by hiding the key.

VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
